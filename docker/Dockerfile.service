FROM python:3.12-slim

WORKDIR /app

# 依赖（不依赖 uv.lock；sentence-transformers 会自动带 CPU 版 torch）
RUN pip install --no-cache-dir \
    fastapi "uvicorn>=0.52" "langgraph>=1.2" "langchain>=1.3" "langchain-core>=1.4" \
    "langchain-openai>=1.1" "langgraph-checkpoint-sqlite>=3.1" "langgraph-checkpoint-postgres>=3.1" \
    "psycopg[binary,pool]>=3.3" "qdrant-client>=1.19" "sentence-transformers>=6.0" \
    "ragas>=0.4" "rank-bm25>=0.2" "langfuse>=4.12" "langsmith>=0.11" \
    "pydantic>=2.13" "pydantic-settings>=2.15" "python-dotenv>=1.2" jieba

COPY src/ ./src/

CMD ["python", "src/run_service.py"]
